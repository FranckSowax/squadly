# Copier en .env et adapter.

# Connexion MySQL / MariaDB.
# En local : mysql://root@127.0.0.1:3306/squadly
# Sur Railway : ${{ MySQL.MYSQL_URL }} (variable de référence)
DATABASE_URL=mysql://root@127.0.0.1:3306/squadly

# Secret de signature des sessions — générer une valeur aléatoire par environnement :
#   openssl rand -base64 32
SESSION_SECRET=change-me

# true = connexion démo sans OAuth externe (bouton « Entrer en démo »).
DEMO_AUTH=true

# Port du serveur de production. Railway l'injecte automatiquement.
PORT=3000
